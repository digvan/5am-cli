{
  "presets": {
    "skin-smooth@1": {
      "name": "Skin smooth @1",
      "status": "experimental",
      "description": "Gentle denoise and reduced texture inside an explicit skin mask. Inspect eyes, lips, hair and edges.",
      "requiresMask": true,
      "selection": "skin",
      "strength": {
        "default": 0.4,
        "min": 0,
        "max": 1
      }
    },
    "subject-pop@1": {
      "name": "Subject Pop",
      "status": "experimental",
      "description": "Lift exposure, clarity and vibrance inside an explicit subject mask. Inspect selection edges.",
      "requiresMask": true,
      "selection": "subject",
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "bw-classic@1": {
      "name": "B&W Classic",
      "status": "experimental",
      "description": "Neutral monochrome with moderate contrast and preserved highlights. Use strength 1 for full black and white.",
      "requiresMask": false,
      "strength": {
        "default": 1,
        "min": 0,
        "max": 1
      }
    },
    "bw-high-contrast@1": {
      "name": "B&W High Contrast",
      "status": "experimental",
      "description": "Deep blacks and a stronger contrast curve for graphic monochrome. Use strength 1 for full black and white.",
      "requiresMask": false,
      "strength": {
        "default": 1,
        "min": 0,
        "max": 1
      }
    },
    "bw-matte@1": {
      "name": "B&W Matte",
      "status": "experimental",
      "description": "Soft monochrome with lifted blacks and compressed highlights. Use strength 1 for full black and white.",
      "requiresMask": false,
      "strength": {
        "default": 1,
        "min": 0,
        "max": 1
      }
    },
    "teal-orange@1": {
      "name": "Teal & Orange",
      "status": "experimental",
      "description": "Channel curves cool shadows toward teal and warm highlights toward orange. This is tonal grading, not skin detection.",
      "requiresMask": false,
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "cinematic@1": {
      "name": "Cinematic",
      "status": "experimental",
      "description": "Restrained saturation, soft blacks, cool shadows and warm highlights. Keeps your original framing.",
      "requiresMask": false,
      "strength": {
        "default": 0.7,
        "min": 0,
        "max": 1
      }
    },
    "wedding-clean@1": {
      "name": "Wedding Clean",
      "status": "experimental",
      "description": "Neutral whites, gentle contrast and restrained color. Review white clothing and skin tones.",
      "requiresMask": false,
      "strength": {
        "default": 0.7,
        "min": 0,
        "max": 1
      }
    },
    "wedding-airy@1": {
      "name": "Wedding Airy",
      "status": "experimental",
      "description": "Brighter midtones, soft shadows and delicate highlights. Set exposure for each image first.",
      "requiresMask": false,
      "strength": {
        "default": 0.6,
        "min": 0,
        "max": 1
      }
    },
    "golden-romance@1": {
      "name": "Golden Romance",
      "status": "experimental",
      "description": "Warm highlights, softened greens and gentle contrast for outdoor portraits.",
      "requiresMask": false,
      "strength": {
        "default": 0.6,
        "min": 0,
        "max": 1
      }
    },
    "editorial-portrait@1": {
      "name": "Editorial Portrait",
      "status": "experimental",
      "description": "Clean color, deeper blacks and defined midtones without skin smoothing.",
      "requiresMask": false,
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "soft-pastel@1": {
      "name": "Soft Pastel",
      "status": "experimental",
      "description": "Soft contrast and subdued colors without an added pink cast or skin smoothing.",
      "requiresMask": false,
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "indoor-celebration@1": {
      "name": "Indoor Celebration",
      "status": "experimental",
      "description": "Lift shadows and control bright highlights. Correct mixed-light white balance separately.",
      "requiresMask": false,
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "family-natural@1": {
      "name": "Family Natural",
      "status": "experimental",
      "description": "Balanced contrast and gentle vibrance with minimal stylization. Keeps skin texture.",
      "requiresMask": false,
      "strength": {
        "default": 0.7,
        "min": 0,
        "max": 1
      }
    },
    "autumn-warmth@1": {
      "name": "Autumn Warmth",
      "status": "experimental",
      "description": "Warm earth tones and restrained greens. Review orange clothing and skin tones.",
      "requiresMask": false,
      "strength": {
        "default": 0.6,
        "min": 0,
        "max": 1
      }
    },
    "landscape-crisp@1": {
      "name": "Landscape Crisp",
      "status": "experimental",
      "description": "Moderate dehaze and texture with richer blues and greens. Inspect edges for halos.",
      "requiresMask": false,
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "woodland-soft@1": {
      "name": "Woodland Soft",
      "status": "experimental",
      "description": "Soft highlights, muted greens and subtle warmth for forest scenes.",
      "requiresMask": false,
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "night-sky-natural@1": {
      "name": "Night Sky Natural",
      "status": "experimental",
      "description": "Restrained tonal contrast and color. No denoise or sharpening; inspect stars at full resolution.",
      "requiresMask": false,
      "strength": {
        "default": 0.5,
        "min": 0,
        "max": 1
      }
    },
    "milky-way-definition@1": {
      "name": "Milky Way Definition",
      "status": "experimental",
      "description": "Gentle contrast and dehaze inside an explicit sky mask. No denoise or sharpening; inspect stars and sky boundaries.",
      "requiresMask": true,
      "selection": "sky",
      "strength": {
        "default": 0.5,
        "min": 0,
        "max": 1
      }
    },
    "dark-moody@1": {
      "name": "Dark & Moody",
      "status": "experimental",
      "description": "Lower exposure, deeper blacks and subdued greens and blues. Check shadow detail before accepting.",
      "requiresMask": false,
      "strength": {
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    }
  },
